{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "cases": [
      {
        "when": "antimatter_portal",
        "model": {
          "type": "model",
          "model": "minecraft:item/antimatter_portal"
        }
      }
    ],
    "fallback": {
      "type": "range_dispatch",
      "property": "custom_model_data",
      "entries": [
        {
          "threshold": 286000,
          "model": {
            "type": "model",
            "model": "minecraft:item/antimatter_teleporter"
          }
        }
      ],
      "fallback": {
        "type": "model",
        "model": "minecraft:item/snowball"
      }
    }
  }
}
